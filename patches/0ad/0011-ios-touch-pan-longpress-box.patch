+
+bool OverGUI(float x, float y)
+{
+	if (!g_GUI)
+		return false;
+	std::shared_ptr<CGUI> gui = g_GUI->GetActiveGUI();
+	return gui && gui->IsScreenPointOverObject(static_cast<int>(x), static_cast<int>(y));
+}
+
+// Light tap of the Taptic Engine when a long press arms box selection.
+void Haptic()
+{
+#if OS_IOS
+	Class cls = objc_getClass("UIImpactFeedbackGenerator");
+	if (!cls)
+		return;
+	id gen = reinterpret_cast<id (*)(Class, SEL)>(objc_msgSend)(cls, sel_registerName("alloc"));
+	gen = reinterpret_cast<id (*)(id, SEL, long)>(objc_msgSend)(gen, sel_registerName("initWithStyle:"), 0);
+	if (!gen)
+		return;
+	reinterpret_cast<void (*)(id, SEL)>(objc_msgSend)(gen, sel_registerName("impactOccurred"));
+	reinterpret_cast<void (*)(id, SEL)>(objc_msgSend)(gen, sel_registerName("release"));
+#endif
+}
