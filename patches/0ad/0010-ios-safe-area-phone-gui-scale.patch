+void CVideoMode::GetGUIInsets(float& left, float& top, float& right, float& bottom) const
+{
+	left = m_InsetPx[0] / m_Scale;
+	top = m_InsetPx[1] / m_Scale;
+	right = m_InsetPx[2] / m_Scale;
+	bottom = m_InsetPx[3] / m_Scale;
+}
+
+#if OS_IOS
+namespace
+{
+struct IOSEdgeInsets { double top, left, bottom, right; };
+}
+#endif
+
+void CVideoMode::UpdateSafeArea()
+{
+	for (float& v : m_InsetPx)
+		v = 0.f;
+#if OS_IOS
+	if (!m_Window || !g_ConfigDB.Get("ios.safearea", true))
+		return;
+	SDL_SysWMinfo info;
+	SDL_VERSION(&info.version);
+	if (!SDL_GetWindowWMInfo(m_Window, &info) || info.subsystem != SDL_SYSWM_UIKIT || !info.info.uikit.window)
+		return;
+	id window = reinterpret_cast<id>(info.info.uikit.window);
+	SEL sel = sel_registerName("safeAreaInsets");
+	if (!class_respondsToSelector(object_getClass(window), sel))
+		return;
+#if defined(__x86_64__)
+	IOSEdgeInsets in;
+	reinterpret_cast<void (*)(IOSEdgeInsets*, id, SEL)>(objc_msgSend_stret)(&in, window, sel);
+#else
+	const IOSEdgeInsets in = reinterpret_cast<IOSEdgeInsets (*)(id, SEL)>(objc_msgSend)(window, sel);
+#endif
+	int ww = 0, wh = 0, dw = 0, dh = 0;
+	SDL_GetWindowSize(m_Window, &ww, &wh);
+	SDL_GL_GetDrawableSize(m_Window, &dw, &dh);
+	const float px = ww > 0 ? static_cast<float>(dw) / ww : 1.f;
+	// Left/right: the notch or Dynamic Island in landscape. Top is the status bar (hidden).
+	// The home indicator is hidden/deferred, so the bottom inset is opt-in.
+	m_InsetPx[0] = in.left * px;
+	m_InsetPx[1] = 0.f;
+	m_InsetPx[2] = in.right * px;
+	m_InsetPx[3] = g_ConfigDB.Get("ios.safearea.bottom", false) ? in.bottom * px : 0.f;
+	LOGMESSAGE("iOS: safe area insets (pt) left %.0f top %.0f right %.0f bottom %.0f, applied (px) %.0f %.0f %.0f %.0f",
+		in.left, in.top, in.right, in.bottom, m_InsetPx[0], m_InsetPx[1], m_InsetPx[2], m_InsetPx[3]);
+#endif
+	if (m_Scale > 0.f)
+	{
+		g_ConfigDB.SetValueString(CFG_SYSTEM, "ios.gui.insetleft", CStr::FromDouble(m_InsetPx[0] / m_Scale));
+		g_ConfigDB.SetValueString(CFG_SYSTEM, "ios.gui.insettop", CStr::FromDouble(m_InsetPx[1] / m_Scale));
+	}
+}
