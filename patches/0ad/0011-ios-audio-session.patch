+#if OS_IOS
+namespace
+{
+/**
+ * iOS: OpenAL Soft plays through a RemoteIO audio unit but never configures the
+ * AVAudioSession, so the app runs with the default SoloAmbient category, which the
+ * ring/silent switch mutes entirely. Games are expected to use the Playback category
+ * (sound.ios.category = "ambient" restores the silent-switch behaviour).
+ */
+void ConfigureIOSAudioSession()
+{
+	Class sessionClass = objc_getClass("AVAudioSession");
+	Class stringClass = objc_getClass("NSString");
+	if (!sessionClass || !stringClass)
+	{
+		LOGWARNING("iOS audio: AVAudioSession not available");
+		return;
+	}
+	id session = reinterpret_cast<id (*)(Class, SEL)>(objc_msgSend)(sessionClass, sel_registerName("sharedInstance"));
+	if (!session)
+		return;
+	const bool ambient = g_ConfigDB.Get("sound.ios.category", std::string("playback")) == "ambient";
+	id category = reinterpret_cast<id (*)(Class, SEL, const char*)>(objc_msgSend)(stringClass, sel_registerName("stringWithUTF8String:"),
+		ambient ? "AVAudioSessionCategoryAmbient" : "AVAudioSessionCategoryPlayback");
+	// AVAudioSessionCategoryOptionMixWithOthers = 1: don't stop the user's own music/podcasts.
+	const unsigned long options = g_ConfigDB.Get("sound.ios.mixwithothers", false) ? 1 : 0;
+	id error = nullptr;
+	const BOOL categoryOk = reinterpret_cast<BOOL (*)(id, SEL, id, unsigned long, id*)>(objc_msgSend)(
+		session, sel_registerName("setCategory:withOptions:error:"), category, options, &error);
+	error = nullptr;
+	const BOOL activeOk = reinterpret_cast<BOOL (*)(id, SEL, BOOL, id*)>(objc_msgSend)(
+		session, sel_registerName("setActive:error:"), YES, &error);
+	LOGMESSAGE("iOS audio: session category %s %s, active %s", ambient ? "Ambient" : "Playback",
+		categoryOk ? "ok" : "FAILED", activeOk ? "ok" : "FAILED");
+}
+} // anonymous namespace
+#endif
