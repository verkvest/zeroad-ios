 #define glBufferSubDataARB glBufferSubData
 #define glDeleteBuffersARB glDeleteBuffers
 #define glGenBuffersARB glGenBuffers
+#include "lib/sysdep/os.h"
+#if OS_IOS
+// iOS has no default framebuffer: SDL renders into its own FBO (SDL_SysWMinfo::info.uikit.framebuffer),
+// so binding framebuffer 0 ("the backbuffer") must bind SDL's FBO instead.
+extern GLuint g_iOSDefaultFramebuffer;
+inline void ios_BindFramebuffer(GLenum target, GLuint framebuffer)
+{
+	glBindFramebuffer(target, framebuffer ? framebuffer : g_iOSDefaultFramebuffer);
+}
+#define glBindFramebufferEXT ios_BindFramebuffer
+#else
 #define glBindFramebufferEXT glBindFramebuffer
+#endif
 #define glCheckFramebufferStatusEXT glCheckFramebufferStatus
