<?xml version="1.0" encoding="utf-8"?>
<!-- iOS port (GPL-2.0+): phone overlay - toolbar for keyboard-only actions, deselect, grid paging,
     long-press ring. Generated by ios/mod/gen_ios_overlay.py. -->
<object name="iosOverlay" size="0 0 100% 100%" z="30">
	<action on="Tick">iosToolbarTick();</action>
	<object name="iosToolbar" size="2 54 530 202">
		<object name="iosButton_pause" type="button" style="StoneButton" size="0 0 72 72" tooltip_style="sessionToolTip" tooltip="Pause or resume the game">
			<object name="iosLabel_pause" type="text" ghost="true" size="0 0 100% 100%" font="sans-bold-stroke-18" textcolor="white" text_align="center" text_valign="center">
				<translatableAttribute id="caption">Pause</translatableAttribute>
			</object>
			<action on="Press">iosToolbarPress("pause");</action>
		</object>
		<object name="iosButton_speed" type="button" style="StoneButton" size="76 0 148 72" tooltip_style="sessionToolTip" tooltip="Change the game speed">
			<object name="iosLabel_speed" type="text" ghost="true" size="0 0 100% 100%" font="sans-bold-stroke-18" textcolor="white" text_align="center" text_valign="center">
				<translatableAttribute id="caption">Speed</translatableAttribute>
			</object>
			<action on="Press">iosToolbarPress("speed");</action>
		</object>
		<object name="iosButton_idleworker" type="button" style="StoneButton" size="152 0 224 72" tooltip_style="sessionToolTip" tooltip="Select the next idle worker">
			<object name="iosIcon_idleworker" type="image" ghost="true" size="14 3 58 47" sprite="stretched:session/minimap-idle.png"/>
			<object name="iosLabel_idleworker" type="text" ghost="true" size="0 44 100% 100%" font="sans-bold-stroke-14" textcolor="white" text_align="center" text_valign="center">
				<translatableAttribute id="caption">Idle</translatableAttribute>
			</object>
			<action on="Press">iosToolbarPress("idleworker");</action>
		</object>
		<object name="iosButton_workers" type="button" style="StoneButton" size="228 0 300 72" tooltip_style="sessionToolTip" tooltip="Select all your workers and citizens">
			<object name="iosIcon_workers" type="image" ghost="true" size="14 3 58 47" sprite="stretched:session/icons/economics.png"/>
			<object name="iosLabel_workers" type="text" ghost="true" size="0 44 100% 100%" font="sans-bold-stroke-14" textcolor="white" text_align="center" text_valign="center">
				<translatableAttribute id="caption">Workers</translatableAttribute>
			</object>
			<action on="Press">iosToolbarPress("workers");</action>
		</object>
		<object name="iosButton_army" type="button" style="StoneButton" size="304 0 376 72" tooltip_style="sessionToolTip" tooltip="Select your whole army">
			<object name="iosIcon_army" type="image" ghost="true" size="14 3 58 47" sprite="stretched:session/icons/attack-request.png"/>
			<object name="iosLabel_army" type="text" ghost="true" size="0 44 100% 100%" font="sans-bold-stroke-14" textcolor="white" text_align="center" text_valign="center">
				<translatableAttribute id="caption">Army</translatableAttribute>
			</object>
			<action on="Press">iosToolbarPress("army");</action>
		</object>
		<object name="iosButton_home" type="button" style="StoneButton" size="380 0 452 72" tooltip_style="sessionToolTip" tooltip="Select the Civic Centre (press again for the next one)">
			<object name="iosIcon_home" type="image" ghost="true" size="14 3 58 47" sprite="stretched:session/icons/focus-rally.png"/>
			<object name="iosLabel_home" type="text" ghost="true" size="0 44 100% 100%" font="sans-bold-stroke-14" textcolor="white" text_align="center" text_valign="center">
				<translatableAttribute id="caption">Home</translatableAttribute>
			</object>
			<action on="Press">iosToolbarPress("home");</action>
		</object>
		<object name="iosButton_camera" type="button" style="StoneButton" size="456 0 528 72" tooltip_style="sessionToolTip" tooltip="Reset the camera to the default angle and zoom">
			<object name="iosIcon_camera" type="image" ghost="true" size="14 3 58 47" sprite="stretched:session/icons/focus-flare.png"/>
			<object name="iosLabel_camera" type="text" ghost="true" size="0 44 100% 100%" font="sans-bold-stroke-14" textcolor="white" text_align="center" text_valign="center">
				<translatableAttribute id="caption">Camera</translatableAttribute>
			</object>
			<action on="Press">iosToolbarPress("camera");</action>
		</object>
		<object name="iosButton_stop" type="button" style="StoneButton" size="0 76 72 148" tooltip_style="sessionToolTip" tooltip="Stop the selected units">
			<object name="iosIcon_stop" type="image" ghost="true" size="14 3 58 47" sprite="stretched:session/icons/stop.png"/>
			<object name="iosLabel_stop" type="text" ghost="true" size="0 44 100% 100%" font="sans-bold-stroke-14" textcolor="white" text_align="center" text_valign="center">
				<translatableAttribute id="caption">Stop</translatableAttribute>
			</object>
			<action on="Press">iosToolbarPress("stop");</action>
		</object>
		<object name="iosButton_work" type="button" style="StoneButton" size="76 76 148 148" tooltip_style="sessionToolTip" tooltip="Send the selected units back to work">
			<object name="iosIcon_work" type="image" ghost="true" size="14 3 58 47" sprite="stretched:session/icons/back-to-work.png"/>
			<object name="iosLabel_work" type="text" ghost="true" size="0 44 100% 100%" font="sans-bold-stroke-14" textcolor="white" text_align="center" text_valign="center">
				<translatableAttribute id="caption">Work</translatableAttribute>
			</object>
			<action on="Press">iosToolbarPress("work");</action>
		</object>
		<object name="iosButton_unload" type="button" style="StoneButton" size="152 76 224 148" tooltip_style="sessionToolTip" tooltip="Unload all garrisoned units">
			<object name="iosIcon_unload" type="image" ghost="true" size="14 3 58 47" sprite="stretched:session/icons/garrison-out.png"/>
			<object name="iosLabel_unload" type="text" ghost="true" size="0 44 100% 100%" font="sans-bold-stroke-14" textcolor="white" text_align="center" text_valign="center">
				<translatableAttribute id="caption">Unload</translatableAttribute>
			</object>
			<action on="Press">iosToolbarPress("unload");</action>
		</object>
		<object name="iosButton_delete" type="button" style="StoneButton" size="228 76 300 148" tooltip_style="sessionToolTip" tooltip="Delete the selection">
			<object name="iosIcon_delete" type="image" ghost="true" size="14 3 58 47" sprite="stretched:session/icons/kill.png"/>
			<object name="iosLabel_delete" type="text" ghost="true" size="0 44 100% 100%" font="sans-bold-stroke-14" textcolor="white" text_align="center" text_valign="center">
				<translatableAttribute id="caption">Delete</translatableAttribute>
			</object>
			<action on="Press">iosToolbarPress("delete");</action>
		</object>
		<object name="iosButton_info" type="button" style="StoneButton" size="304 76 376 148" tooltip_style="sessionToolTip" tooltip="Show or hide the details of the selection (health, stats, portraits)">
			<object name="iosIcon_info" type="image" ghost="true" size="14 3 58 47" sprite="stretched:session/icons/encyclopaedia.png"/>
			<object name="iosLabel_info" type="text" ghost="true" size="0 44 100% 100%" font="sans-bold-stroke-14" textcolor="white" text_align="center" text_valign="center">
				<translatableAttribute id="caption">Info</translatableAttribute>
			</object>
			<action on="Press">iosToolbarPress("info");</action>
		</object>
		<object name="iosButton_map" type="button" style="StoneButton" size="380 76 452 148" tooltip_style="sessionToolTip" tooltip="Show or hide the minimap">
			<object name="iosLabel_map" type="text" ghost="true" size="0 0 100% 100%" font="sans-bold-stroke-18" textcolor="white" text_align="center" text_valign="center">
				<translatableAttribute id="caption">Map</translatableAttribute>
			</object>
			<action on="Press">iosToolbarPress("map");</action>
		</object>
	</object>
	<!-- Deselect: a 66 x 66 (44pt) X next to the selection details, positioned by ios_hud.js. -->
	<object name="iosDeselect" type="button" style="StoneButton" size="0 0 66 66" hidden="true" tooltip_style="sessionToolTip" tooltip="Deselect">
		<object type="text" ghost="true" size="0 0 100% 100%" font="sans-bold-stroke-24" textcolor="white" text_align="center" text_valign="center">X</object>
		<action on="Press">iosToolbarPress("deselect");</action>
	</object>
	<!-- Paging of the build / train grid (2 rows per page). -->
	<object name="iosPageButton" type="button" style="StoneButton" size="0 0 72 72" hidden="true" tooltip_style="sessionToolTip" tooltip="Next page of buttons">
		<object name="iosPageLabel" type="text" ghost="true" size="0 0 100% 100%" font="sans-bold-stroke-18" textcolor="white" text_align="center" text_valign="center"/>
		<action on="Press">iosToolbarPress("page");</action>
	</object>
	<!-- Long press armed (box select): a ring under the finger for half a second. -->
	<object name="iosArmedRing" type="image" ghost="true" hidden="true" size="0 0 96 96" sprite="stretched:session/minimap_circle_modern.png"/>
</object>
